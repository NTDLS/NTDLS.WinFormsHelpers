<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<UseWindowsForms>true</UseWindowsForms>
		<TargetFrameworks>net9.0-windows;net10.0-windows;</TargetFrameworks>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<IncludeSymbols>True</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<ApplicationIcon>Logo.ico</ApplicationIcon>
		<Title>NTDLS.WinFormsHelpers</Title>
		<Authors>NetworkDLS</Authors>
		<Company>NetworkDLS</Company>
		<Product>NTDLS.WinFormsHelpers</Product>
		<Copyright>Copyright © 2026 NetworkDLS</Copyright>
		<PackageProjectUrl>https://github.com/NTDLS/NTDLS.WinFormsHelpers</PackageProjectUrl>
		<PackageIcon>Logo.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/NTDLS/NTDLS.WinFormsHelpers</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>winforms;helpers;invoke;validation</PackageTags>
		<PackageReleaseNotes>
			Theming: InitializeApplication(ThemeColorMode) to choose light or dark instead of following Windows, and text colors for the normal background (ErrorText, GoodText, WarningText, InfoText).
		</PackageReleaseNotes>
		<Version>1.6.5</Version>
		<EnableNETAnalyzers>False</EnableNETAnalyzers>
		<Description>Helpers for working with WinForms. Getting and setting values, simplifications for invoke, theming, etc.</Description>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\Images\Logo.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="NTDLS.Helpers" Version="1.4.0" />
		<!-- Until NTDLS.Localization is published to NuGet; then use a PackageReference instead. -->
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Forms\FormAbout.cs">
			<SubType>Form</SubType>
		</Compile>
	</ItemGroup>

</Project>
